# Development values only. Compose works without copying this file.
APP_ENV=development
JWT_SECRET=local-development-key-change-before-any-deployment
POSTGRES_PASSWORD=motorloop-local-only
STORAGE_ACCESS_KEY=local-motorloop
STORAGE_SECRET_KEY=local-motorloop-storage-only
PUBLIC_ORIGIN=http://localhost:8080
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
MEDIA_PUBLIC_URL=http://localhost:8080/media
# Per-process Redis pool includes one connection per active WebSocket subscription.
REDIS_CONNECT_TIMEOUT=2
REDIS_SOCKET_TIMEOUT=5
REDIS_MAX_CONNECTIONS=256
# Seconds; account/session revocation is rechecked at least this often on idle sockets.
WEBSOCKET_AUTH_INTERVAL=15
# Never set development adapters in production. See docs/09-scaffold.md.
